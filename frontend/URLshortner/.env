# Backend URL Configuration
# For production deployment, use the production backend URL
VITE_BACKEND_URL=https://quicklinkbackend.onrender.com

# For local development, uncomment the line below and comment out the production URL
# Make sure the backend is running locally on port 8000
# Also ensure the backend CORS is configured to allow http://localhost:5173
# VITE_BACKEND_URL=http://localhost:8000